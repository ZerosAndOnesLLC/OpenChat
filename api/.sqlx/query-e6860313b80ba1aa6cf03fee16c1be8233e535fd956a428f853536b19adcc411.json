{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT DISTINCT d.id, d.org_id, d.created_by, d.created_at\n        FROM direct_messages d\n        INNER JOIN messages m ON m.dm_id = d.id\n        WHERE m.created_at > NOW() - INTERVAL '7 days'\n        ORDER BY d.created_at DESC\n        LIMIT 100\n        ",
