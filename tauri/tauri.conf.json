{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenChat",
  "version": "0.1.0",
  "identifier": "com.openchat.desktop",
  "build": {
    "frontendDist": "./dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": "bash /home/mack/OpenChat/tauri/scripts/dev-servers.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenChat",
        "visible": false,
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
