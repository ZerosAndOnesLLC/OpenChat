############################################
# Fast Build Dockerfile (ARM64)
# Assumes binary is pre-built on host
############################################
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies only
RUN apt-get update && apt upgrade -y && apt-get install -y --no-install-recommends \
    libssl3 \
    libpq5 \
    ca-certificates \
    curl \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Create user
RUN useradd -m -s /bin/bash svc_openchat
WORKDIR /home/svc_openchat

# Copy the pre-built binary from host
COPY ./target/release/openchat-api ./openchat-api

# Set ownership
RUN chown -R svc_openchat:svc_openchat /home/svc_openchat

# Run as non-root
USER svc_openchat
EXPOSE 7001
ENV RUST_LOG=debug
CMD ["./openchat-api"]
